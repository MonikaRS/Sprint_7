# ============================================
# Allure Reports and Binaries
# ============================================
# Local Allure cache and reports
.allure/
allure-*/
allure-current/
allure-results/
allure-report/

# Allure binary distribution (kept in tools/)
tools/allure/allure-2.24.0/

# ============================================
# Exceptions - DO NOT IGNORE these
# ============================================
# We need to commit Allure test results in target
!target/allure-results/
# But ignore temporary files inside
target/allure-results/*.txt
target/allure-results/*.tmp
